{
  "name": "@pocketmice/sdk",
  "version": "0.5.0",
  "description": "The TypeScript SDK of Pocketmice, a cloud drive that people and AI agents share: the drive, for a program that holds an API key",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BitMiracle-AI/Pocketmice.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts --no-config --tsconfig tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@pocketmice/client": "workspace:*",
    "@pocketmice/contract": "workspace:*",
    "@types/node": "^26.6.6",
    "tsdown": "^0.23.7"
  }
}
