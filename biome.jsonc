{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    // Every exclusion is a file a tool generates
    "includes": ["**", "!packages/db/migrations", "!packages/db/src/schema/auth.ts", "!apps/app/src/routeTree.gen.ts"]
  },
  "css": {
    "parser": {
      // The index.css shadcn generates for the app is written with Tailwind's own syntax (@theme, @apply), which
      // is not parsed unless this is on
      "tailwindDirectives": true
    }
  },
  "linter": {
    "rules": {
      "suspicious": {
        // Imports between files must not form a cycle: A imports B, and B imports A back, directly or through other
        // files. In a cycle, one of the files can be handed a value that is not initialised yet when it loads.
        // Type-only imports do not count: they are gone at run time.
        // Two things are harmless at run time and reported anyway: a dynamic import() counts as an import, and so do
        // two components that render each other. Fix a report by moving what both sides need into a third file.
        // The rule looks at files, not folders: the domains of the api may import from each other, as long as the
        // files themselves do not loop.
        "noImportCycles": "error"
      },
      "style": {
        // File names: code files are camelCase (getServerInfo.ts, checkWorkspace.mjs).
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["camelCase"]
          }
        }
      }
    }
  },
  "overrides": [
    {
      // contract and client are shared by every kind of caller: a web page, a phone app and Node all import them,
      // so they cannot use Node's built-in modules. Neither can the sdk, which is for a program in any runtime that
      // has a fetch. Tests only run in Node and are exempt.
      "includes": ["packages/contract/src/**", "packages/client/src/**", "packages/sdk/src/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    },
    {
      // The next four blocks are the import rules inside the api's src:
      // 1. Direction. domains (the product) imports from http; http never imports from domains.
      // 2. The set a running server uses (instances.ts) is imported by main.ts alone; other code is given what it
      //    needs by main.ts. A test that reached it would get the set built from this machine's .env: the
      //    development database.
      // 3. domains and http do not read environment variables: no process.env and no import of env.ts.
      //    A test in a domain may import env.ts: it has to learn from the environment which database server its
      //    temporary database goes on.
      // Paths are written relative (starting with ../). Written as **/domains/**, the rule would also catch a path
      // inside a package, like @pocketmice/contract/domains/server.
      // When several blocks cover one file, the import restrictions of a later block replace those of an earlier
      // one whole; they are not merged. So each block spells out every restriction that applies to it.
      // This block covers the files at the top level (except main.ts); the two folders have blocks of their own.
      "includes": ["apps/api/src/**", "!apps/api/src/main.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["./instances.ts", "../**/instances.ts"],
                    "message": "Only main.ts imports instances.ts. Other code takes what it needs as a parameter."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/domains/**"],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "error",
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**/instances.ts", "../**/env.ts"],
                    "message": "Code in domains/ does not read environment variables or import instances.ts. Take what you need as a parameter: main.ts passes it in."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // The tests in the domains and the setup they share: as the block above, except that env.ts may be imported
      "includes": ["apps/api/src/domains/**/*.test.ts", "apps/api/src/domains/**/testing.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**/instances.ts"],
                    "message": "Only main.ts imports instances.ts. A test builds its own instances."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // The storage keeps bytes and knows nothing of the product: it imports from neither of the other two folders,
      // and reads no environment variable
      "includes": ["apps/api/src/storage/**"],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "error",
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**/domains/**", "../**/http/**"],
                    "message": "Code in storage/ must not import from domains/ or http/: it keeps bytes, and knows nothing of files or requests."
                  },
                  {
                    "group": ["../**/instances.ts", "../**/env.ts"],
                    "message": "Code in storage/ does not read environment variables or import instances.ts. Take what you need as a parameter: main.ts passes it in."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/http/**"],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "error",
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**/domains/**"],
                    "message": "Code in http/ must not import from domains/."
                  },
                  {
                    "group": ["../**/instances.ts", "../**/env.ts"],
                    "message": "Code in http/ does not read environment variables or import instances.ts. Take what you need as a parameter: main.ts passes it in."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // This block must stay. Biome turns the React rules on by itself when it finds a react dependency, but no
      // longer once linter.rules is written at the top level, as it is above. Without this block the rules on the
      // dependencies of a hook, on where a hook is called and on an index used as a key are off in the app, and
      // nothing says so.
      "includes": ["apps/app/**"],
      "linter": {
        "domains": {
          "react": "recommended"
        }
      }
    },
    {
      // Imports inside the app's src go one way: routes import from features, and features from the code every
      // page shares (components, hooks, lib). This block and the next stop an import that goes the other way.
      // Features may import from each other.
      // The rules name folders, and the top level of src has only these (scripts/checkTopLevel.mjs), so no folder
      // is outside both blocks.
      "includes": ["apps/app/src/components/**", "apps/app/src/hooks/**", "apps/app/src/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/features/**", "**/routes/**"],
                    "message": "Shared code (components, hooks, lib) must not import from features or routes."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/app/src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/routes/**"],
                    "message": "Features must not import from routes."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // The pages are in more than one language, so the words a person reads are in the text files (see
      // apps/app/src/lib/language/text.ts): a word written between two tags is reported. Let through is only what
      // is the same in every language: the name of the product.
      // What the rule does not see: a word in an attribute (aria-label="…"), and one a plain function returns.
      // Those two are kept out by whoever writes the code.
      "includes": ["apps/app/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noJsxLiterals": {
              "level": "error",
              "options": {
                "allowedStrings": ["Pocketmice"]
              }
            }
          }
        }
      }
    },
    {
      // From here down are the kinds of file whose name is written another way; a later block replaces an earlier
      // one. A component file has the name of the component it exports (LoginPage.tsx exports LoginPage): the name
      // of a .tsx file must be one of the names it exports.
      "includes": ["apps/app/**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["export"]
              }
            }
          }
        }
      }
    },
    {
      // The components of shadcn keep the lowercase names with hyphens its tool gives them (alert-dialog.tsx)
      "includes": ["apps/app/src/components/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["kebab-case"]
              }
            }
          }
        }
      }
    },
    {
      // The file that holds the sentences of a language has the name of the language (zh-hans.ts)
      "includes": ["apps/app/src/**/text/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["kebab-case"]
              }
            }
          }
        }
      }
    },
    {
      // The name of a file in routes is how its address is written, which the router decides (__root.tsx,
      // $spaceId.tsx). main.tsx is where the pages start, and exports nothing.
      "includes": ["apps/app/src/routes/**", "apps/app/src/main.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    }
  ],
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "none"
    }
  }
}
