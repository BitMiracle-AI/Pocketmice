{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "jsx": "react-jsx",
    // The text of another language is written against the type of the English one (see src/lib/language/text.ts).
    // With this on, a sentence that is handed something to fill in and does not use it is reported too
    "noUnusedParameters": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  // The tests are checked apart (tsconfig.test.json): they run in Node and use its types, which a page has not
  "exclude": ["src/**/*.test.ts"]
}
