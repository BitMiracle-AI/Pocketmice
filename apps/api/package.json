{
  "name": "@pocketmice/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "start": "node --env-file-if-exists=.env src/main.ts",
    "migrate": "node --env-file-if-exists=.env src/migrate.ts",
    "typecheck": "tsc",
    "test": "node --env-file-if-exists=.env --test \"src/**/*.test.ts\"",
    "auth:schema": "node --env-file-if-exists=.env node_modules/auth/dist/index.mjs generate --config src/instances.ts --output ../../packages/db/src/schema/auth.ts --yes"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@pocketmice/contract": "workspace:*",
    "@pocketmice/db": "workspace:*",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@pocketmice/client": "workspace:*",
    "@types/node": "^26.6.6",
    "auth": "^1.7.18"
  }
}
