# Local configuration of the api. Copy it to .env in this folder and fill it in; .env is never committed.

# The database. Pocketmice uses a role and a database of its own, so it can share a Postgres server with other
# projects. Once, as an administrator, run:
#   create role pocketmice login createdb password '<password>';
#   create database pocketmice owner pocketmice;
# createdb (the right to create databases) is for the tests: every test file creates a temporary database of its
# own and drops it when done. Its name is the development database's name followed by _test_, the time it was
# created and some random characters. Tests never read or write the development database.
# The role of a deployed server runs no tests: create it without createdb.
DATABASE_URL=postgres://pocketmice:<password>@localhost:5432/pocketmice

# The secret that signs sessions: a long random string, like the output of `openssl rand -base64 32`.
# Changing it signs everyone out.
BETTER_AUTH_SECRET=

# The address of the api as callers reach it. Locally that is the address it listens on; deployed, it is the
# address people use, like https://api.example.com.
API_URL=http://localhost:11210

# The web pages allowed to call the api, separated by commas. Write each as scheme, host and port, with no path and
# no trailing slash. A request from any other web page is refused.
# The web app and the api must be under the same registrable domain (like app.example.com and api.example.com), or
# browsers do not send the sign-in cookie.
WEB_ORIGINS=http://localhost:11211

# The port the api listens on. Leave it unset for the default, 11210. If the port is taken the api exits with an
# error; it never picks another one.
# PORT=11210
