# Local configuration of the api. Copy it to .env in this folder and fill it in; .env is never committed.

# The database. Pocketmice uses a role and a database of its own, so it can share a Postgres server with other
# projects. Once, as an administrator, run:
#   create role pocketmice login createdb password '<password>';
#   create database pocketmice owner pocketmice;
# createdb (the right to create databases) is for the tests: every test file creates a temporary database of its
# own and drops it when done. Its name is the development database's name followed by _test_, the time it was
# created and some random characters. Tests never read or write the development database.
# The role of a deployed server runs no tests: create it without createdb.
DATABASE_URL=postgres://pocketmice:<password>@localhost:5432/pocketmice

# The secret that signs sessions: a long random string, like the output of `openssl rand -base64 32`.
# Changing it signs everyone out.
BETTER_AUTH_SECRET=

# The address of the api as callers reach it. Locally that is the address it listens on; deployed, it is the
# address people use, like https://api.example.com.
API_URL=http://localhost:11210

# The web pages allowed to call the api, separated by commas. Write each as scheme, host and port, with no path and
# no trailing slash. A request from any other web page is refused.
# The web app and the api must be under the same registrable domain (like app.example.com and api.example.com), or
# browsers do not send the sign-in cookie.
WEB_ORIGINS=http://localhost:11211

# Mail, and with it how people sign in. Set both of SMTP_URL and MAIL_FROM, or neither: with one alone the api does
# not start.
# Neither: the server sends no mail, and people sign in with an email address and a password. Nothing proves that an
# address belongs to whoever signed up with it, and a password that is forgotten cannot be set again.
# Both: people sign in with a code sent to their email address, and there are no passwords. Someone new signs up by
# signing in.
# A server that goes from passwords to codes keeps its accounts: each is signed in to with a code, under its address.
# The first time, its password, its sessions and its API keys are taken away, and the person makes their keys again.
# Going back is not supported: an account made with a code has no password.
#
# SMTP_URL is the SMTP server of any mail service, with the account to send as. With smtp the connection is
# encrypted as soon as the server offers to (STARTTLS, usually port 587); with smtps it is encrypted from the start
# (port 465). A password with characters like @ : / in it is written percent-encoded.
# MAIL_FROM is who the mail is from. The mail service must let the account send as it.
# SMTP_URL=smtp://user:password@smtp.example.com:587
# MAIL_FROM=Pocketmice <noreply@example.com>
#
# For development, in place of the two above: people sign in with a code, and the mail is not sent but printed in
# the output of the api, where you read the code. Nobody else can: not for a server other people use.
# MAIL_TO_CONSOLE=true

# Where the bytes of files are kept: a bucket of an S3-compatible service. Without one the api does not start.
# The database holds what the files are; the bucket holds their content. A backup needs both.
# A server, the tests and a developer's machine all keep them in a bucket, so each takes the same path through the
# code. For development that is a bucket kept for it at a cloud service, or an S3-compatible server on this machine
# (a MinIO listens on http://localhost:9000 and needs S3_FORCE_PATH_STYLE=true). The tests need neither: they
# start a small S3 of their own, in memory.
#
# S3_ENDPOINT is the address of the service; leave it out for AWS. S3_FORCE_PATH_STYLE=true puts the bucket in the
# path of the address and not in its host.
# Verified against MinIO and Alibaba Cloud OSS. Other services differ in details and have not been tried.
# For OSS: S3_ENDPOINT is its S3-compatible address, https://s3.oss-cn-beijing.aliyuncs.com for that region
# (https://s3.oss-cn-beijing-internal.aliyuncs.com from a server of theirs in the same region), S3_REGION is
# oss-cn-beijing, and S3_FORCE_PATH_STYLE is left out.
# The key needs four rights on the objects of the bucket and no others: put, get, delete, and abort an upload
# that goes up in parts (in OSS: PutObject, GetObject, DeleteObject, AbortMultipartUpload).
# Give the bucket a rule that removes uploads left unfinished after some days (a lifecycle rule that aborts
# multipart uploads). A large file goes up in parts. When the caller gives up, the api removes the parts it
# had sent; when the api itself is stopped half way (a new version is deployed, the machine goes down), they
# stay in the bucket, where no listing of objects shows them and they are paid for.
S3_BUCKET=pocketmice
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# The port the api listens on. Leave it unset for the default, 11210. If the port is taken the api exits with an
# error; it never picks another one.
# PORT=11210

# The address the api listens on. Leave it unset for the default, 127.0.0.1: this machine only, with the reverse
# proxy on the same machine. Set it when the proxy is somewhere else. The container image sets it to 0.0.0.0, since
# a proxy is always outside the container.
# HOST=127.0.0.1
