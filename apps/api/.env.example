# Local configuration of the api. Copy it to .env in this folder and fill it in; .env is never committed.

# The web pages allowed to call the api, separated by commas. Write each as scheme, host and port, with no path and
# no trailing slash. A request from any other web page is refused.
WEB_ORIGINS=http://localhost:11211

# The port the api listens on. Leave it unset for the default, 11210. If the port is taken the api exits with an
# error; it never picks another one.
# PORT=11210
