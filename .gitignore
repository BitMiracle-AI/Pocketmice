# Internal development files, never committed: the rules the maintainers'
# coding agents read. Public-facing docs (README, CONTRIBUTING, …) are separate
# deliverables written on their own.
AGENTS.md
CLAUDE.md

# Secrets and real env files (only *.example may be committed)
.env
.env.*
!.env.example

# Node / pnpm
node_modules/
dist/

# What the router's plugin keeps while it writes the app's list of routes
.tanstack/

# Scratch pages and scripts that only ever run on one machine
/apps/*/temp/

# What a unit keeps on the disk of the machine it runs on: for the api, the files people uploaded
/apps/*/data/

# System and editors
.DS_Store
.idea/
.vscode/
